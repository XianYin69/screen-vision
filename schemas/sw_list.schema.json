{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sw.py list 输出",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["index", "title", "box", "visible_state"],
    "properties": {
      "index": {"type": "integer", "description": "z-order 下标，顶层在前，可直接喂 --index"},
      "title": {"type": "string"},
      "handle": {"type": ["integer", "null"], "description": "HWND"},
      "box": {
        "type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4,
        "description": "[left, top, right, bottom]；top 可为负（跨屏/贴顶）"
      },
      "visible_state": {"enum": ["visible", "minimized", "tiny"]}
    }
  }
}
